generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── کاربران و دسترسی ─────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("AUTHOR") // ADMIN | EDITOR | AUTHOR | VIEWER
  status       String    @default("INVITED") // INVITED | ACTIVE | SUSPENDED | DISABLED
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?
  articles     Article[]
  ownedArticles Article[]  @relation("ArticleOwner")
  sessions     Session[]
  media        Media[]
  notifications Notification[]
  activityLogs ActivityLog[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  createdAt DateTime @default(now())
  expiresAt DateTime
  lastSeenAt DateTime @default(now())
}

// ─── محتوا ────────────────────────────────────────────────────────

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  color       String    @default("#64748b")
  articles    Article[]
  createdAt   DateTime  @default(now())
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  slug     String       @unique
  articles ArticleTag[]
}

model Article {
  id             String         @id @default(cuid())
  title          String
  slug           String         @unique
  excerpt        String         @default("")
  content        String         @default("")
  status         String         @default("DRAFT") // DRAFT | IN_REVIEW | NEEDS_REVISION | APPROVED | PUBLISHED | ARCHIVED
  coverImageId   String?
  authorId       String
  author         User           @relation(fields: [authorId], references: [id])
  categoryId     String?
  category       Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags           ArticleTag[]
  seoTitle       String?
  seoDescription String?
  noindex        Boolean        @default(false)
  publishedAt    DateTime?
  views          Int            @default(0)
  reviewNote     String?
  ownerId        String?        // مالک مسئول صحت اطلاعات (ممکن است غیر از نویسنده باشد)
  owner          User?          @relation("ArticleOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  reviewAt       DateTime?      // تاریخ بازبینی بعدی محتوا
  lastReviewedAt DateTime?      // آخرین بار که «اطلاعات معتبر است» تأیید شد
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  versions       ArticleVersion[]
  comments       Comment[]
  bundleItems    BundleItem[]

  @@index([status])
  @@index([authorId])
  @@index([publishedAt])
  @@index([ownerId])
  @@index([reviewAt])
}

model ArticleVersion {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  title     String
  content   String
  excerpt   String
  editorId  String
  editorName String
  note      String?
  createdAt DateTime @default(now())

  @@index([articleId])
}

model ArticleTag {
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

model Comment {
  id          String   @id @default(cuid())
  articleId   String
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  authorName  String
  authorEmail String
  content     String
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt   DateTime @default(now())

  @@index([status])
}

// ─── رسانه ────────────────────────────────────────────────────────

model Media {
  id           String   @id @default(cuid())
  filename     String   // نام امن روی سرور
  originalName String   // نام اصلی فایل
  mimeType     String
  size         Int      // بایت
  width        Int?
  height       Int?
  altText      String   @default("")
  data         String   // base64
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

// ─── ساختار سایت ──────────────────────────────────────────────────

model Page {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String   @default("")
  status    String   @default("DRAFT") // DRAFT | PUBLISHED
  showInNav Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MenuItem {
  id    String @id @default(cuid())
  label String
  url   String
  order Int    @default(0)
}

// ─── فرم‌ها ───────────────────────────────────────────────────────

model FormSubmission {
  id        String   @id @default(cuid())
  formName  String   @default("تماس با ما")
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("NEW") // NEW | READ | ARCHIVED
  createdAt DateTime @default(now())

  @@index([status])
}

// ─── پایش و پیکربندی ──────────────────────────────────────────────

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName    String   @default("سیستم")
  action      String   // LOGIN, LOGOUT, CREATE, UPDATE, DELETE, PUBLISH, ...
  entityType  String   // ARTICLE, USER, MEDIA, ...
  entityId    String?
  entityTitle String?
  details     String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([entityType])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // REVIEW_REQUEST | APPROVED | REJECTED | PUBLISHED | COMMENT | FORM | ACCESS
  title     String
  body      String   @default("")
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─── مرکز کارها و شخصی‌سازی ─────────────────────────────────────

// کار واگذارشده به کاربر (دستی یا خودکار از گردش کار)
model Task {
  id           String    @id @default(cuid())
  title        String
  description  String?
  type         String    @default("GENERAL") // GENERAL | REVIEW | REVISION | HEALTH
  priority     String    @default("MEDIUM") // LOW | MEDIUM | HIGH
  status       String    @default("OPEN") // OPEN | DONE | CANCELLED
  dueDate      DateTime?
  link         String?   // مسیر داخلی پنل مانند #/articles/x/edit
  relatedType  String?   // نوع موجودیت مرتبط: ARTICLE | ...
  relatedId    String?   // شناسه موجودیت مرتبط (برای بستن خودکار کارها)
  assignedToId String
  assignedById String?
  assignedByName String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  doneAt       DateTime?

  @@index([assignedToId, status])
  @@index([relatedType, relatedId])
}

// علاقه‌مندی/سنجاق‌شدن صفحه‌ها و رکوردها برای دسترسی سریع (Ctrl+K)
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  itemType  String   // PAGE | ARTICLE | MEDIA | ...
  itemId    String   // برای صفحه‌های پنل: مسیر مثل /tasks
  title     String
  path      String
  createdAt DateTime @default(now())

  @@unique([userId, itemType, itemId])
  @@index([userId])
}

// ─── همکاری، کمپین و بهبود کیفیت ────────────────────────────────

// گفتگوهای درون‌محتوایی (کنار رکورد، نه در پیام‌رسان)
model ContentComment {
  id             String    @id @default(cuid())
  entityType     String    // ARTICLE | PAGE
  entityId       String
  body           String
  authorId       String
  authorName     String
  mentions       String    @default("[]") // JSON آرایه‌ای از شناسه کاربران منشن‌شده
  status         String    @default("OPEN") // OPEN | RESOLVED
  assigneeId     String?
  assigneeName   String?
  parentId       String?   // رشته گفتگو: پاسخ به نظر والد (عمق ۱)
  parent         ContentComment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies        ContentComment[] @relation("CommentThread")
  versionRef     String?   // اتصال اختیاری گفتگو به نسخه محتوا
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  resolvedAt     DateTime?
  resolvedByName String?

  @@index([entityType, entityId, status])
  @@index([parentId])
}

// بسته انتشار (کمپین) — مجموعه مقالات که با هم آماده و منتشر می‌شوند
model PublishBundle {
  id            String       @id @default(cuid())
  title         String
  note          String       @default("")
  status        String       @default("DRAFT") // DRAFT | SCHEDULED | PUBLISHING | PUBLISHED | PARTIAL | FAILED | CANCELLED
  scheduledAt   DateTime?
  publishedAt   DateTime?
  createdById   String
  createdByName String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  items         BundleItem[]

  @@index([status])
}

model BundleItem {
  id             String        @id @default(cuid())
  bundleId       String
  bundle         PublishBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  articleId      String
  article        Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  snapshotStatus String        @default("") // وضعیت مقاله در لحظه افزودن به بسته
  result         String?       // SUCCESS | FAILED
  message        String?

  @@unique([bundleId, articleId])
  @@index([bundleId])
}

// مرکز عملیات — عملیات طولانی با وضعیت زنده، نتیجهٔ تک‌تک موارد، لغو و تلاش مجدد
model OperationLog {
  id            String    @id @default(cuid())
  type          String // BULK_PUBLISH_ARTICLES | BULK_UNPUBLISH_ARTICLES | BUNDLE_PUBLISH | MEDIA_UPLOAD | CSV_EXPORT | OTHER
  title         String
  status        String    @default("QUEUED") // QUEUED | RUNNING | SUCCESS | PARTIAL | FAILED | CANCEL_REQUESTED | CANCELLED
  totalItems    Int       @default(0)
  doneItems     Int       @default(0)
  failedItems   Int       @default(0)
  initiatorId   String?
  initiatorName String    @default("سیستم")
  resultSummary String    @default("")
  errorsJson    String    @default("[]") // JSON [{ item, reason }] (برای عملیات قدیمی بدون آیتم)
  relatedId     String?
  retryOfId     String?   // شناسه عملیات اصلی در صورت «تلاش مجدد»
  cancelRequested Boolean @default(false) // درخواست لغو؛ پردازشگر در گام بعدی متوقف می‌شود
  startedAt     DateTime?
  heartbeatAt   DateTime? // آخرین نشانهٔ حیات پردازشگر (تشخیص قطع‌شدن)
  createdAt     DateTime  @default(now())
  finishedAt    DateTime?
  items         OperationItem[]

  @@index([createdAt])
  @@index([status])
}

// نتیجهٔ تک‌تک موارد یک عملیات دسته‌ای
model OperationItem {
  id          String   @id @default(cuid())
  operationId String
  operation   OperationLog @relation(fields: [operationId], references: [id], onDelete: Cascade)
  refType     String   // ARTICLE | ...
  refId       String
  label       String
  status      String   @default("PENDING") // PENDING | SUCCEEDED | FAILED | SKIPPED | CANCELLED
  message     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([operationId, status])
}

// ریدایرکت ثبت‌شده پس از تغییر آدرس محتوای منتشرشده
model Redirect {
  id            String   @id @default(cuid())
  fromPath      String   @unique // مسیر قدیمی، مانند /articles/old-slug
  toPath        String   // مسیر جدید
  kind          String   @default("SLUG_CHANGE") // SLUG_CHANGE | MANUAL
  entityType    String?  // ARTICLE | PAGE
  entityId      String?
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
}

// الگوهای آماده محتوا (ایجاد نسخه مستقل از الگو)
model ContentTemplate {
  id              String   @id @default(cuid())
  name            String
  description     String   @default("")
  type            String   @default("ARTICLE") // ARTICLE | LANDING
  titleTemplate   String   @default("")
  excerptTemplate String   @default("")
  contentTemplate String   @default("")
  tagNames        String   @default("[]") // JSON آرایه نام برچسب‌ها
  categoryId      String?
  isSystem        Boolean  @default(false)
  createdById     String?
  createdByName   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// واژه‌نامه و کنترل هویت برند (هشدار غیرمسدودکننده در ویرایشگر)
model GlossaryTerm {
  id            String   @id @default(cuid())
  term          String   @unique
  replacement   String   @default("")
  type          String   @default("PREFERRED") // PREFERRED | FORBIDDEN | REVIEW
  note          String   @default("")
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
}

// پشتیبانی تشخیصی — گزارش مشکل با شناسه قابل‌ردگیری
model SupportTicket {
  id             String    @id @default(cuid())
  code           String    @unique
  userName       String
  userEmail      String
  page           String    @default("")
  steps          String    @default("")
  errorInfo      String    @default("")
  userAgent      String    @default("")
  status         String    @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?
  resolvedByName String?

  @@index([status])
}

// موارد نادیده‌گرفته‌شده در مرکز سلامت محتوا (با دلیل)
model HealthIgnore {
  id          String   @id @default(cuid())
  issueKey    String   @unique // کلید پایدار مشکل، مانند article-cover:cuid
  reason      String
  ignoredById String
  ignoredByName String
  createdAt   DateTime @default(now())
}
